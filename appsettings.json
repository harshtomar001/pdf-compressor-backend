{
  "PdfTools": {
    "QPdf": "/usr/bin/qpdf",
    "MuPdf": "/usr/bin/mutool",
    "Ghostscript": "/usr/bin/gs"
  },
  "JobCleanup": {
    "RetentionMinutes": 120,
    "IntervalMinutes": 10
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "pdf_compressor.Controllers": "Information",
      "pdf_compressor.Workers": "Information",
      "pdf_compressor.Services": "Information"
    }
  }
}